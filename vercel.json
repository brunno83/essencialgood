{
  "cleanUrls": true,
  "redirects": [
    { "source": "/ADV-sonnus", "destination": "/adv-sonnus/", "permanent": true },
    { "source": "/ADV-slimsoda", "destination": "/adv-slimsoda/", "permanent": true },
    { "source": "/ADV-crowned", "destination": "/adv-crowned/", "permanent": true },
    { "source": "/ADV-linfaflow", "destination": "/adv-linfaflow/", "permanent": true },
    { "source": "/adv-sonnus", "destination": "/adv-sonnus/", "permanent": true },
    { "source": "/adv-slimsoda", "destination": "/adv-slimsoda/", "permanent": true },
    { "source": "/adv-crowned", "destination": "/adv-crowned/", "permanent": true },
    { "source": "/adv-linfaflow", "destination": "/adv-linfaflow/", "permanent": true },
    { "source": "/crownedpower", "destination": "/crownedpower/", "permanent": true },
    { "source": "/CROWNEDpower", "destination": "/crownedpower/", "permanent": true },
    { "source": "/Crownedpower", "destination": "/crownedpower/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ADV-sonnus/:path*", "destination": "/adv-sonnus/:path*" },
    { "source": "/ADV-slimsoda/:path*", "destination": "/adv-slimsoda/:path*" },
    { "source": "/ADV-crowned/:path*", "destination": "/adv-crowned/:path*" },
    { "source": "/ADV-linfaflow/:path*", "destination": "/adv-linfaflow/:path*" },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "sonnus.essencialgood.com" }
      ],
      "destination": "/adv-sonnus/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "slimsoda.essencialgood.com" }
      ],
      "destination": "/adv-slimsoda/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "crowned.essencialgood.com" }
      ],
      "destination": "/adv-crowned/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "linfaflow.essencialgood.com" }
      ],
      "destination": "/adv-linfaflow/:path*"
    },
    { "source": "/crowned/images/:path*", "destination": "/crowned/images/:path*" },
    { "source": "/linfaflow/images/:path*", "destination": "/linfaflow/images/:path*" },
    { "source": "/sonnus/images/:path*", "destination": "/sonnus/images/:path*" },
    { "source": "/crownedpower/fonts/:path*", "destination": "/crownedpower/fonts/:path*" },
    { "source": "/crownedpower/images/:path*", "destination": "/crownedpower/images/:path*" },
    { "source": "/crownedpower", "destination": "/crownedpower/index.html" },
    { "source": "/crownedpower/:path*", "destination": "/crownedpower/:path*" },
    { "source": "/slimsodapower/assets/:path*", "destination": "/slimsodapower/assets/:path*" },
    { "source": "/slimsodapower", "destination": "/slimsodapower/index.html" },
    { "source": "/slimsodapower/:path*", "destination": "/slimsodapower/:path*" },
    { "source": "/linfaflowpower/assets/:path*", "destination": "/linfaflowpower/assets/:path*" },
    { "source": "/linfaflowpower/cart-details/:path*", "destination": "/linfaflowpower/cart-details/:path*" },
    { "source": "/linfaflowpower", "destination": "/linfaflowpower/index.html" },
    { "source": "/linfaflowpower/:path*", "destination": "/linfaflowpower/:path*" },
    { "source": "/sonnuspower", "destination": "/sonnuspower/index.html" },
    { "source": "/sonnuspower/:path*", "destination": "/sonnuspower/:path*" },
    { "source": "/slimsoda", "destination": "/index.html" },
    { "source": "/slimsoda/:path*", "destination": "/index.html" },
    { "source": "/listicle/slimsoda", "destination": "/index.html" },
    { "source": "/listicle/slimsoda/:path*", "destination": "/index.html" },
    { "source": "/linfaflow", "destination": "/index.html" },
    { "source": "/linfaflow/:path*", "destination": "/index.html" },
    { "source": "/sonnus", "destination": "/index.html" },
    { "source": "/sonnus/:path*", "destination": "/index.html" },
    { "source": "/crowned", "destination": "/index.html" },
    { "source": "/crowned/:path*", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
